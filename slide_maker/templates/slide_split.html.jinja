{%- if slide.kicker %}<h2 class="kicker">{{ slide.kicker }}</h2>{% endif %}
{%- if slide.title %}<h1>{{ slide.title }}</h1>{% endif %}
<div class="slide-body">
  <div class="split-panels">
    {%- for panel in slide.panels %}
    <div class="panel">
      <div class="panel-media">
        <img src="{{ panel.image }}" alt="{{ panel.alt }}">
        {%- if panel.reference %}<span class="citation-badge">{% if panel.reference.doi_url %}<a href="{{ panel.reference.doi_url }}" target="_blank" rel="noopener">{{ panel.reference.number }}</a>{% else %}{{ panel.reference.number }}{% endif %}</span>{% endif %}
      </div>
      {%- if panel.label %}<div class="panel-label">{{ panel.label }}</div>{% endif %}
    </div>
    {%- endfor %}
  </div>
</div>
