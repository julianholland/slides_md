<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ deck.page_title }}</title>
<link rel="stylesheet" href="vendor/katex/katex.min.css">
<link rel="stylesheet" href="assets/style.css">
{% if deck.theme or deck.theme_font_body %}
<style>
:root {
{% for key, value in deck.theme.items() %}
  --{{ key }}: {{ value }};
{% endfor %}
{% if deck.theme_font_body %}
  --font-body: {{ deck.theme_font_body | safe }};
{% endif %}
{% if deck.theme_watermark %}
  --watermark-opacity: {{ deck.theme_watermark_opacity }};
  --watermark-size: {{ deck.theme_watermark_size }};
{% endif %}
}
</style>
{% endif %}
</head>
<body>
<div class="deck">
{% if deck.theme_watermark %}
<img class="theme-watermark" src="{{ deck.theme_watermark }}" alt="" aria-hidden="true">
{% endif %}
{% for slide in slides %}
<section class="slide{% if slide.layout == 'title' %} title-slide{% elif slide.layout == 'image' %} image-slide{% endif %}{% if slide.classes %} {{ slide.classes }}{% endif %}" id="{{ slide.id }}" data-display-index="{{ slide.display_index }}"{% if slide.phase_step is not none %} data-phase-step="{{ slide.phase_step }}" data-phase-step-count="{{ slide.phase_step_count }}"{% endif %}>
{%- if slide.background %}
  <div class="bg-layer" style="background-image: url('{{ slide.background }}'); opacity: {{ slide.background_opacity }};{% if slide.layout == 'image' %} background-size: {{ slide.fit }};{% endif %}"{% if slide.layout == 'image' %} role="img" aria-label="{{ slide.image_alt }}"{% else %} aria-hidden="true"{% endif %}></div>
{%- endif %}
{%- if slide.notes %}
  <!-- notes: {{ slide.notes }} -->
{%- endif %}
{%- if slide.layout == 'image' and slide.image_reference %}
  <span class="citation-badge image-layout-badge">{% if slide.image_reference.doi_url %}<a href="{{ slide.image_reference.doi_url }}" target="_blank" rel="noopener">{{ slide.image_reference.number }}</a>{% else %}{{ slide.image_reference.number }}{% endif %}</span>
{%- endif %}
  <div class="slide-content">
    {% include layout_templates[slide.layout] %}
  </div>
{%- if slide.citation_footnotes %}
  <div class="citation-footnotes">
    {%- for fn in slide.citation_footnotes %}
    <div class="citation-footnote-entry">{{ fn.number }}. {{ fn.entry.html | safe }}{% if fn.entry.doi_url %} <a href="{{ fn.entry.doi_url }}" target="_blank" rel="noopener">DOI</a>{% endif %}</div>
    {%- endfor %}
  </div>
{%- endif %}
</section>
{% endfor %}
<div class="nav-zone prev" aria-label="Previous slide"></div>
<div class="nav-zone next" aria-label="Next slide"></div>
<div class="slide-counter"><span class="current">1</span> / <span class="total"></span></div>
</div>
<div class="lightbox" id="lightbox"><img src="" alt=""></div>
<script src="vendor/katex/katex.min.js"></script>
<script src="vendor/katex/auto-render.min.js"></script>
<script src="assets/script.js"></script>
</body>
</html>
