{%- if slide.kicker %}<h2 class="kicker">{{ slide.kicker }}</h2>{% endif %}
{%- if slide.title %}<h1>{{ slide.title }}</h1>{% endif %}
{%- if slide.subtitle %}<p class="subtitle">{{ slide.subtitle }}</p>{% endif %}
<div class="slide-body">
  <div class="text-col">
    {{ slide.body_html | safe }}
    {%- if slide.formula_html %}
    <div class="formula-box">{{ slide.formula_html | safe }}</div>
    {%- if slide.formula_note %}
    <p class="formula-note">{{ slide.formula_note }}</p>
    {%- endif %}
    {%- endif %}
  </div>
  <div class="media-col">
    {%- if slide.image %}
    <div class="media-item">
      <img src="{{ slide.image }}" alt="{{ slide.image_alt }}">
      {%- if slide.image_label %}<div class="panel-label">{{ slide.image_label }}</div>{% endif %}
      {%- if slide.image_reference %}<span class="citation-badge">{% if slide.image_reference.doi_url %}<a href="{{ slide.image_reference.doi_url }}" target="_blank" rel="noopener">{{ slide.image_reference.number }}</a>{% else %}{{ slide.image_reference.number }}{% endif %}</span>{% endif %}
    </div>
    {%- elif slide.video %}
    <video src="{{ slide.video }}" controls></video>
    {%- elif slide.image_rows %}
    <div class="image-grid">
      {%- for row in slide.image_rows %}
      <div class="image-grid-row" style="flex: {{ row.grow }} 1 0">
        {%- for img in row.items %}
        <div class="image-grid-item" style="flex: {{ img.grow }} 1 0">
          <img src="{{ img.src }}" alt="{{ img.alt }}">
          {%- if img.label %}<div class="panel-label">{{ img.label }}</div>{% endif %}
          {%- if img.reference %}<span class="citation-badge">{% if img.reference.doi_url %}<a href="{{ img.reference.doi_url }}" target="_blank" rel="noopener">{{ img.reference.number }}</a>{% else %}{{ img.reference.number }}{% endif %}</span>{% endif %}
        </div>
        {%- endfor %}
      </div>
      {%- endfor %}
    </div>
    {%- elif slide.panels %}
    <div class="split-panels">
      {%- for panel in slide.panels %}
      <div class="panel">
        <div class="panel-media">
          <img src="{{ panel.image }}" alt="{{ panel.alt }}">
          {%- if panel.reference %}<span class="citation-badge">{% if panel.reference.doi_url %}<a href="{{ panel.reference.doi_url }}" target="_blank" rel="noopener">{{ panel.reference.number }}</a>{% else %}{{ panel.reference.number }}{% endif %}</span>{% endif %}
        </div>
        {%- if panel.label %}<div class="panel-label">{{ panel.label }}</div>{% endif %}
      </div>
      {%- endfor %}
    </div>
    {%- endif %}
  </div>
</div>
